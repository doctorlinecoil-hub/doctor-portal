# Supabase (filled automatically by the Vercel + Supabase integration)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=

# Claude API key from console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: model for drafting letters
ANTHROPIC_MODEL=claude-opus-5-5

# One-time code for creating the first admin at /setup (choose any long code)
SETUP_CODE=

# Optional: Morning (חשבונית ירוקה) for issuing tax invoice / receipts from the system
MORNING_API_KEY_ID=
MORNING_API_KEY_SECRET=
# MORNING_ENV=sandbox

# Emails (zimun, reminders, letters as PDF) through Resend: resend.com → API Keys
RESEND_API_KEY=
# The sender. The domain must be verified in Resend (Domains → Add domain)
MAIL_FROM="מרפאת ד״ר אלרן חנוך <clinic@doctorline.co.il>"
# Optional: where replies to the emails go (e.g. the clinic's Gmail)
MAIL_REPLY_TO=
# The portal's public address, for links in emails
APP_URL=https://portal.doctorline.co.il
# Protects the daily reminders job (any long random text)
CRON_SECRET=
